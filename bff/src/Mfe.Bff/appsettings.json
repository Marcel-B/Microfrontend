{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "http://localhost:5001",
    "ClientId": "mfe-bff",
    "ClientSecret": "",
    "Scopes": [ "openid", "profile", "email", "roles", "offline_access", "api" ],
    "RequireHttpsMetadata": true
  },
  "Frontends": {
    "Default": "vue",
    "Variants": {
      "vue": {
        "BasePath": "/vue/",
        "Remotes": [
          {
            "Name": "vueDemo",
            "Entry": "/remotes/vue-demo/remoteEntry.js",
            "Pages": [
              { "Path": "/demo", "Title": "Demo", "Module": "./DemoPage", "Icon": "pi pi-star" },
              { "Path": "/admin", "Title": "Administration", "Module": "./AdminPage", "Icon": "pi pi-shield", "Roles": [ "admin" ] }
            ]
          }
        ]
      },
      "react": {
        "BasePath": "/react/",
        "Remotes": [
          {
            "Name": "reactDemo",
            "Entry": "/remotes/react-demo/remoteEntry.js",
            "Pages": [
              { "Path": "/demo", "Title": "Demo", "Module": "./DemoPage", "Icon": "star" },
              { "Path": "/admin", "Title": "Administration", "Module": "./AdminPage", "Icon": "shield", "Roles": [ "admin" ] }
            ]
          }
        ]
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "vue-host": {
        "ClusterId": "vue-host",
        "Match": { "Path": "/vue/{**catch-all}" }
      },
      "vue-remote-demo": {
        "ClusterId": "vue-remote-demo",
        "Match": { "Path": "/remotes/vue-demo/{**catch-all}" }
      },
      "react-host": {
        "ClusterId": "react-host",
        "Match": { "Path": "/react/{**catch-all}" }
      },
      "react-remote-demo": {
        "ClusterId": "react-remote-demo",
        "Match": { "Path": "/remotes/react-demo/{**catch-all}" }
      },
      "api": {
        "ClusterId": "api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{**catch-all}" },
        "Metadata": { "Bff.AccessToken": "true" }
      }
    },
    "Clusters": {
      "vue-host": { "Destinations": { "dev": { "Address": "http://localhost:5173" } } },
      "vue-remote-demo": { "Destinations": { "dev": { "Address": "http://localhost:5174" } } },
      "react-host": { "Destinations": { "dev": { "Address": "http://localhost:5175" } } },
      "react-remote-demo": { "Destinations": { "dev": { "Address": "http://localhost:5176" } } },
      "api": { "Destinations": { "dev": { "Address": "http://localhost:5100" } } }
    }
  }
}
