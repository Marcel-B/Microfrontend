{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:5001",
    "Audience": "react-demo-api",
    "RequireHttpsMetadata": true
  },
  "Ui": {
    "BasePath": "/remotes/react-demo/"
  },
  "Registration": {
    "HostUrl": "http://localhost:5020",
    "Address": "http://localhost:5021",
    "Remote": {
      "Id": "react-demo",
      "FederationName": "reactDemo",
      "DisplayName": { "de": "Demo", "en": "Demo" },
      "Group": "Demo",
      "Pages": [
        {
          "Path": "/demo",
          "Title": { "de": "Klick-Demo", "en": "Click demo" },
          "Module": "./DemoPage",
          "Icon": "star",
          "Order": 10
        },
        {
          "Path": "/admin",
          "Title": { "de": "Administration", "en": "Administration" },
          "Module": "./AdminPage",
          "Icon": "shield",
          "Roles": [ "admin" ],
          "Order": 20
        }
      ]
    }
  }
}
