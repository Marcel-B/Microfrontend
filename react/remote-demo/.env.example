# Stage-dependent settings of this remote BFF. Copy to .env next to this file (.env is not checked in) and adjust
# per stage. Keys as environment variables ("__" for ":"); they override appsettings.json, real environment variables
# of the stage override them.

# Browser tab title of the remote's pages; {title} is the page's title in the user's language.
# Test stage: "Test - Klick-Demo". Leave it out for the shell's own tab title ("Klick-Demo · Microfrontend …").
Registration__Remote__TabTitle=Test - {title}

# A single page may have its own, per language (index as in appsettings.json "Pages"):
# Registration__Remote__Pages__1__TabTitle__de=Test - Admin-Bereich

# Developing this remote against a stage: the stage's shell loads the UI from this machine and sends the API calls here
# (the stage needs DevOverrides__Enabled=true; then set the addresses on the shell's page "Lokale Remotes" /
# "Local remotes"). Never set these on the stage itself.
# Do not register at the stage's host, or every user of the stage would get this machine:
# Registration__HostUrl=
# Validate the tokens of the stage's Identity server (the audience stays the same):
# Jwt__Authority=https://identity.test.example
# Jwt__RequireHttpsMetadata=true
# The stage shell's origin, for CORS on this BFF and on the Vite dev server:
# DevCors__Origins__0=https://shell.test.example
