{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "http://localhost:5001",
    "ClientId": "mfe-vue-host",
    "ClientSecret": "",
    "Scopes": [ "openid", "profile", "email", "roles", "offline_access", "vue-demo-api" ],
    "RequireHttpsMetadata": true
  },
  "DevOverrides": {
    "Enabled": false
  },
  "Session": {
    "CookieName": "mfe.vue.session"
  },
  "ReverseProxy": {
    "Routes": {
      "vue-components": {
        "ClusterId": "vue-components",
        "Match": { "Path": "/remotes/vue-components/{**catch-all}" }
      }
    },
    "Clusters": {
      "vue-components": { "Destinations": { "static": { "Address": "http://localhost:5175" } } }
    }
  }
}
