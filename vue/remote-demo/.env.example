# Stage-dependent settings of this remote BFF. Copy to .env next to this file (.env is not checked in) and adjust
# per stage. Keys as environment variables ("__" for ":"); they override appsettings.json, real environment variables
# of the stage override them.

# Browser tab title of the remote's pages; {title} is the page's title in the user's language.
# Test stage: "Test - Klick-Demo". Leave it out for the shell's own tab title ("Klick-Demo · Microfrontend …").
Registration__Remote__TabTitle=Test - {title}

# A single page may have its own, per language (index as in appsettings.json "Pages"):
# Registration__Remote__Pages__1__TabTitle__de=Test - Admin-Bereich
