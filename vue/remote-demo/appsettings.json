{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:5001",
    "Audience": "vue-demo-api",
    "RequireHttpsMetadata": true
  },
  "Ui": {
    "BasePath": "/remotes/vue-demo/"
  },
  "Registration": {
    "HostUrl": "http://localhost:5010",
    "Address": "http://localhost:5011",
    "ClientId": "mfe-vue-demo",
    "ClientSecret": "",
    "Scope": "vue-registry",
    "Remote": {
      "Id": "vue-demo",
      "FederationName": "vueDemo",
      "DisplayName": { "de": "Demo", "en": "Demo" },
      "Pages": [
        {
          "Path": "/demo",
          "Title": { "de": "Klick-Demo", "en": "Click demo" },
          "Module": "./DemoPage",
          "Icon": "pi pi-star",
          "Order": 10
        },
        {
          "Path": "/admin",
          "Title": { "de": "Administration", "en": "Administration" },
          "Module": "./AdminPage",
          "Icon": "pi pi-shield",
          "Roles": [ "admin" ],
          "Order": 20
        }
      ]
    }
  }
}
