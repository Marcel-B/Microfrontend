<Project Sdk="Microsoft.NET.Sdk">

  <!-- Frontends inside their BFF project (ClientApp/), as in YuE-UI: DevServerLauncher starts the Vite dev servers
       with "dotnet run", ClientApp.targets installs the npm packages and bundles the build into wwwroot on publish. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Same implicit usings as in Microsoft.NET.Sdk.Web projects. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
