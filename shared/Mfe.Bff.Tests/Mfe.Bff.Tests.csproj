    <None Include="..\..\react\host\bff\appsettings.json" Link="variants\react-host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vue\remote-demo\bff\appsettings.json" Link="variants\vue-demo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\react\remote-demo\bff\appsettings.json" Link="variants\react-demo.json" CopyToOutputDirectory="PreserveNewest" />
