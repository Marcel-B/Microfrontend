{
  "name": "microfrontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "vue/host/ClientApp",
    "vue/remote-demo/ClientApp",
    "vue/components",
    "react/host/ClientApp",
    "react/remote-demo/ClientApp",
    "react/components",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run build:bff && concurrently -k -n identity,vue,react -c gray,green,cyan \"npm:dev:identity\" \"npm:dev:vue:all\" \"npm:dev:react:all\"",
    "dev:vue": "npm run build:bff && concurrently -k -n identity,vue -c gray,green \"npm:dev:identity\" \"npm:dev:vue:all\"",
    "dev:react": "npm run build:bff && concurrently -k -n identity,react -c gray,cyan \"npm:dev:identity\" \"npm:dev:react:all\"",
    "dev:vue:all": "concurrently -k -n vue-host-bff,vue-demo-bff -c blue,green \"npm:dev:vue:host-bff\" \"npm:dev:vue:demo-bff\"",
    "dev:react:all": "concurrently -k -n react-host-bff,react-demo-bff -c blue,green \"npm:dev:react:host-bff\" \"npm:dev:react:demo-bff\"",
    "dev:identity": "dotnet run --project ../Identity/src/Identity.Server --launch-profile http",
    "dev:vue:host-bff": "dotnet run --no-build --project vue/host --launch-profile http",
    "dev:vue:demo-bff": "dotnet run --no-build --project vue/remote-demo --launch-profile http",
    "dev:react:host-bff": "dotnet run --no-build --project react/host --launch-profile http",
    "dev:react:demo-bff": "dotnet run --no-build --project react/remote-demo --launch-profile http",
    "build:bff": "dotnet build Microfrontend.slnx",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:bff": "dotnet test Microfrontend.slnx",
    "test:e2e": "npm run build:bff && npm test -w @mfe/e2e"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
